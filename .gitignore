# Local tool/build state.
.dart_tool/
.packages
.pub-cache/
build/
coverage/
.flutter-plugins
.flutter-plugins-dependencies
*.log
.local/
.scaffold/
pubspec_overrides.yaml
doc/api/

# Local agent and MCP configuration (also used by the example template).
.dart_skills/
.agents/
.claude/
.gemini/
.cursor/
.vscode/mcp.json
.codex/
.mcp.json

# Serverpod Cloud CLI local state.
.scloud/

# Local configuration and generated credentials must never be committed.
**/config/passwords.yaml
**/config/firebase_service_account_key.json
**/config/*.local.yaml
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/docker-data/

# IDE and OS state.
.idea/
*.iml
.DS_Store
Thumbs.db

**/.serverpod/
**/sp_*.db*
**/web/app/

# Python test-helper bytecode
__pycache__/
*.py[cod]
